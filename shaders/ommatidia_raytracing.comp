#version 430 core

#include "commons.glsl"

// one thread per ray
layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Inputs
// Triangles
layout(std430, binding = 0) readonly buffer OmmatidiaInputBuffer { Ommatidium u_ommatidia_data[]; };
layout(std430, binding = 1) readonly buffer TriangleBuffer { Triangle u_triangles[]; };
layout(std430, binding = 2) readonly buffer MaterialBuffer { Material u_materials[]; };

// Outputs
layout(std430, binding = 3) writeonly buffer RayResultBuffer { vec4 u_ray_results[]; };

// BVH accelerated geometry
layout(std430, binding = 5) readonly buffer BvhBuffer { BvhNode u_bvh_nodes[]; };
layout(std430, binding = 6) readonly buffer PrimitiveBuffer { Point u_points[]; };

// Uniforms: skybox and texture array for scene materials
layout(binding = 0) uniform samplerCube u_skybox;
layout(binding = 1) uniform sampler2DArray u_scene_textures;

// Uniforms queried by name
uniform int u_num_ommatidia;
uniform int u_samples_per_ommatidium;
uniform float u_time;
uniform float u_point_radius;
uniform uint u_num_triangles;
uniform uint u_num_bvh_nodes;
uniform int u_num_materials;
uniform uint u_num_primitives;

uniform mat4 u_camera_orientation; // to transform ommatidia directions to world space
uniform vec3 u_camera_position;    // for ray origin

// Functions

// Möller–Trumbore ray-triangle intersection algorithm
HitInfo intersect_triangle(Ray r, Triangle tri) {
    HitInfo hit;
    hit.found = false;
    hit.is_point_hit = false; // Mark as triangle hit
    vec3 edge1 = tri.v1.xyz - tri.v0.xyz;
    vec3 edge2 = tri.v2.xyz - tri.v0.xyz;
    vec3 h = cross(r.direction, edge2);
    float a = dot(edge1, h);

    if (a > -1e-6 && a < 1e-6) return hit; // ray is parallel to the triangle

    float f = 1.0 / a;
    vec3 s = r.origin - tri.v0.xyz;
    float u = f * dot(s, h);

    if (u < 0.0 || u > 1.0) return hit;

    vec3 q = cross(s, edge1);
    float v = f * dot(r.direction, q);

    if (v < 0.0 || u + v > 1.0) return hit;

    float t = f * dot(edge2, q);
    if (t > 1e-6) { // ray intersection
        hit.found = true;
        hit.t = t;
        hit.barycentric_coords = vec3(1.0 - u - v, u, v);
    }
    return hit;
}

// Ray-sphere intersection
HitInfo intersect_sphere(Ray r, vec3 center, float radius) {
    HitInfo hit;
    hit.found = false;
    hit.is_point_hit = true; // Mark as point hit
    vec3 oc = r.origin - center;
    float a = dot(r.direction, r.direction);
    float b = 2.0 * dot(oc, r.direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - 4 * a * c;
    if (discriminant >= 0) {
        // We want the closest intersection in front of the ray
        float t = (-b - sqrt(discriminant)) / (2.0 * a);
        if (t > 1e-6) {
            hit.found = true;
            hit.t = t;
        }
        // Optional: If the first hit was behind, check the second one
        // else {
        //    t = (-b + sqrt(discriminant)) / (2.0 * a);
        //    if (t > 1e-6) {
        //        hit.found = true;
        //        hit.t = t;
        //    }
        // }
    }
    return hit;
}

// Axis-Aligned Bounding Box (AABB) intersection function
float intersect_aabb(Ray r, vec3 aabb_min, vec3 aabb_max) {
    vec3 inv_dir = 1.0 / r.direction;
    vec3 t1 = (aabb_min - r.origin) * inv_dir;
    vec3 t2 = (aabb_max - r.origin) * inv_dir;

    vec3 t_min_vec = min(t1, t2);
    vec3 t_max_vec = max(t1, t2);

    float t_near = max(max(t_min_vec.x, t_min_vec.y), t_min_vec.z);
    float t_far = min(min(t_max_vec.x, t_max_vec.y), t_max_vec.z);

    // Condition for a valid intersection:
    // t_far >= 0.0: The entire AABB is not behind the ray origin.
    // t_near <= t_far: The ray actually passes through the box.
    if (t_near > t_far || t_far < 0.0) {
        return 1.0/0.0; // infinity
    }

    // If t_near is negative, the ray starts inside the box, so the hit is at t=0.
    return max(0.0, t_near);
}

void main() {
    uint global_id = gl_GlobalInvocationID.x;

    // Guard clause
    if (global_id >= (u_num_ommatidia * u_samples_per_ommatidium)) {
        return;
    }

    uint ommatidium_idx = global_id / u_samples_per_ommatidium;
    uint sample_idx = global_id % u_samples_per_ommatidium;

    // Generate the ray for this thread
    Ommatidium om = u_ommatidia_data[ommatidium_idx];
    vec3 om_world_dir = (u_camera_orientation * om.direction).xyz;
    vec3 om_world_origin = u_camera_position + (u_camera_orientation * om.origin).xyz;

    vec3 up = abs(om_world_dir.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(up, om_world_dir));
    vec3 bitangent = cross(om_world_dir, tangent);

    float r1 = rand(vec2(ommatidium_idx, sample_idx), u_time);
    float r2 = rand(vec2(ommatidium_idx, sample_idx) + 0.5, u_time);

    Ray r;
    r.origin = om_world_origin;
    r.direction = sampledir(om, tangent, bitangent, om_world_dir, r1, r2);

    // Trace the ray
    HitInfo closest_hit;
    closest_hit.found = false;
    closest_hit.t = 1.0/0.0; // initialize distance to infinity

    // Trace against meshes (brute-force) // TODO: this should also use a BVH
    if (u_num_triangles > 0) {
        for (uint i = 0; i < u_num_triangles; ++i) {
            HitInfo current_hit = intersect_triangle(r, u_triangles[i]);
            if (current_hit.found && current_hit.t < closest_hit.t) {
                closest_hit = current_hit;
                closest_hit.is_point_hit = false;
                closest_hit.primitive_idx = i;
            }
        }
    }

    // Trace against Point Cloud using BVH
    if (u_num_bvh_nodes > 0) {
        // A fixed-size stack is used for traversal on the GPU (64 is deep enough for almost any BVH)
        uint traversal_stack[64];
        uint stack_ptr = 0;
        traversal_stack[stack_ptr++] = 0u; // Start at the root node (index 0)

        while(stack_ptr > 0u) {
            uint node_idx = traversal_stack[--stack_ptr];
            BvhNode node = u_bvh_nodes[node_idx];

            // Unpack node data
            vec3 aabb_min = node.data1.xyz;
            vec3 aabb_max = node.data2.xyz;

            // Check intersection distance against the current closest hit
            float dist_to_aabb = intersect_aabb(r, aabb_min, aabb_max);
            if (dist_to_aabb >= closest_hit.t) {
                continue; // Prune this entire branch
            }

            // Unpack metadata by re-interpreting the float bits as unsigned integers
            uint left_or_first_idx = floatBitsToUint(node.data1.w);
            uint primitive_count = floatBitsToUint(node.data2.w);

            if (primitive_count > 0u) { // leaf: test primitives
                for(uint i = 0u; i < primitive_count; i++) {
                    uint prim_idx = left_or_first_idx + i;
                    Point p = u_points[prim_idx];

                    HitInfo p_hit = intersect_sphere(r, p.pos.xyz, u_point_radius);
                    if (p_hit.found && p_hit.t < closest_hit.t) {
                        closest_hit.found = true;
                        closest_hit.is_point_hit = true;
                        closest_hit.t = p_hit.t;
                        closest_hit.primitive_idx = prim_idx;
                    }
                }
            } else { // internal node: push children to stack
                // Pushing right child first (left+1), then left, so left gets processed first
                if (stack_ptr < 63) traversal_stack[stack_ptr++] = left_or_first_idx + 1; // Right
                if (stack_ptr < 63) traversal_stack[stack_ptr++] = left_or_first_idx;     // Left
            }
        }
    }

    // Shade the result
    vec3 final_color;
    if (closest_hit.found) {
        if (closest_hit.is_point_hit) {
            // It was a point hit
            Point hit_point = u_points[closest_hit.primitive_idx];
            // Simple shading using point color and a fake directional light
            vec3 light_dir = normalize(vec3(0.5, 1.0, 0.5));
            float diffuse = max(0.1, dot(normalize(hit_point.normal.xyz), light_dir));
            final_color = hit_point.color.rgb * diffuse;
        } else {
            // It was a triangle hit
            Triangle hit_tri = u_triangles[closest_hit.primitive_idx];
            Material hit_mat = u_materials[hit_tri.material_idx];

            // interpolate UV coordinates
            vec2 hit_uv = hit_tri.uv0 * closest_hit.barycentric_coords.x +
                          hit_tri.uv1 * closest_hit.barycentric_coords.y +
                          hit_tri.uv2 * closest_hit.barycentric_coords.z;

            uint texture_layer = hit_mat.texture_idx;
            final_color = texture(u_scene_textures, vec3(hit_uv, texture_layer)).rgb;
        }
    } else {
        // Hit nothing, sample the skybox
        final_color = texture(u_skybox, r.direction).rgb;
    }

    // Write final color for this single ray to the intermediate buffer
    u_ray_results[global_id] = vec4(final_color, 1.0);
}