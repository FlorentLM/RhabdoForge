#version 430 core

#ifdef PATH_TRACING
#include "trace_path.glsl"
#else
#include "trace_simple.glsl"
#endif

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input and output
layout(std430, binding = 0) readonly buffer OmmatidiaInputBuffer { Ommatidium ommatidia_data[]; };
layout(std430, binding = 1) writeonly buffer RayResultBuffer { vec4 ray_results[]; };

// Uniforms
uniform uint dither_counter;
uniform mat4 cam_to_world;
uniform int nb_samples;
uniform bool use_quasi_random;

void main() {
    uint global_id = gl_GlobalInvocationID.x;

    if (global_id >= (nb_samples * ommatidia_data.length())) {
        return;
    }

    uint ommatidium_idx = global_id / nb_samples;
    uint sample_idx = global_id % nb_samples;

    Ommatidium om = ommatidia_data[ommatidium_idx];

    uint base_seed = ommatidium_idx * 1973u + dither_counter * 26699u;
    uint rng_state = pcg_hash(base_seed + sample_idx * 749u);

    // Generate ray direction
    vec3 om_world_dir = (cam_to_world * om.direction).xyz;
    vec3 om_world_origin = (cam_to_world * om.origin).xyz;
    vec3 up = abs(om_world_dir.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(up, om_world_dir));
    vec3 bitangent = cross(om_world_dir, tangent);

    float r1, r2;
    if (use_quasi_random) {
        // Halton sequence
        uint halton_idx = dither_counter * uint(nb_samples) + sample_idx + 1u;
        float h1 = halton_sequence(halton_idx, 2u);
        float h2 = halton_sequence(halton_idx, 3u);

        // Per-ommatidium random offset to decorrelate spatial sampling
        uint om_hash = pcg_hash(ommatidium_idx * 1973u);
        float offset1 = float(om_hash & 0xFFFFu) / 65535.0;
        float offset2 = float((om_hash >> 16u) & 0xFFFFu) / 65535.0;

        r1 = clamp(fract(h1 + offset1), 1e-6, 1.0);  //log(0) in sampledir
        r2 = fract(h2 + offset2);
    } else {
        // Regular randomness
        r1 = random_float(rng_state);
        r2 = random_float(rng_state);
    }
    vec3 direction = sampledir(om, tangent, bitangent, om_world_dir, r1, r2);

    // Setup Ray
    Ray r;
    r.origin = om_world_origin;
    r.t = 1.0/0.0;
    r.inv_direction = 1.0 / direction;

    vec3 final_color = trace(r, rng_state);
    ray_results[global_id] = vec4(final_color, 1.0);
}
