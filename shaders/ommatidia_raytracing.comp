#version 430 core

#include "raytracing_commons.glsl"

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// Input and output
layout(std430, binding = 0) readonly buffer OmmatidiaInputBuffer { Ommatidium ommatidia_data[]; };
layout(std430, binding = 4) writeonly buffer RayResultBuffer { vec4 ray_results[]; };

// Uniforms
uniform float time;
uniform mat4 cam_to_world;
uniform int nb_samples;


void main() {
    uint global_id = gl_GlobalInvocationID.x;

    if (global_id >= (nb_samples * ommatidia_data.length())) {
        return;
    }

    uint ommatidium_idx = global_id / nb_samples;
    uint sample_idx = global_id % nb_samples;

    Ommatidium om = ommatidia_data[ommatidium_idx];

    // Generate ray
    vec3 om_world_dir = (cam_to_world * om.direction).xyz;
    vec3 om_world_origin = (cam_to_world * om.origin).xyz;
    vec3 up = abs(om_world_dir.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(up, om_world_dir));
    vec3 bitangent = cross(om_world_dir, tangent);
    float r1 = rand(vec2(ommatidium_idx, sample_idx), time);
    float r2 = rand(vec2(ommatidium_idx, sample_idx) + 0.5, time);
    vec3 direction = sampledir(om, tangent, bitangent, om_world_dir, r1, r2);

    // Setup Ray
    Ray r;
    r.origin = om_world_origin;
    r.t = 1.0/0.0;
    r.inv_direction = 1.0 / direction;

    // Trace and store result
    vec3 final_color = trace(r);
    ray_results[global_id] = vec4(final_color, 1.0);
}