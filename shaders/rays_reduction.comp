#version 430 core

// One thread per ommatidium
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: Result of the raytracing pass
layout(std430, binding = 0) readonly buffer RayResultBuffer { vec4 ray_results[]; };

// Output: Final averaged colors
layout(std430, binding = 1) writeonly buffer FinalColorBuffer { vec4 final_colors[]; };

//Uniforms queried by name
uniform int nb_samples;
uniform int nb_ommatidia;

void main() {
    uint ommatidium_idx = gl_GlobalInvocationID.x;
    if (ommatidium_idx >= nb_ommatidia) {
        return;
    }

    vec3 total_color = vec3(0.0);
    uint start_idx = ommatidium_idx * nb_samples;

    for (int i = 0; i < nb_samples; ++i) {
        total_color += ray_results[start_idx + i].rgb;
    }

    if (nb_samples > 0) {
        total_color /= float(nb_samples);
    }

    final_colors[ommatidium_idx] = vec4(total_color, 1.0);
}