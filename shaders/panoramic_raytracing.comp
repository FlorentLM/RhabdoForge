#version 430 core

#ifdef PATH_TRACING
#include "trace_path.glsl"
#else
#include "trace_simple.glsl"
#endif

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Output
layout(binding = 0, rgba32f) uniform writeonly image2D output_image;

// Uniforms
uniform float time;
uniform mat4 cam_to_world;
uniform int nb_samples;

void main() {

    ivec2 pixel_coords = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(output_image);

    if (pixel_coords.x >= dims.x || pixel_coords.y >= dims.y) {
        return;
    }

    uint base_seed = uint(pixel_coords.x) * 1973u + uint(pixel_coords.y) * 9277u + uint(time * 26699.0);
    vec3 accumulated_color = vec3(0.0);

    for (int s = 0; s < nb_samples; s++) {
        uint rng_state = pcg_hash(base_seed + uint(s) * 749u);

        // Jitter pixel position for anti-aliasing
        vec2 jitter = vec2(random_float(rng_state), random_float(rng_state)) - 0.5;

        vec2 uv = (vec2(pixel_coords) + 0.5 + jitter) / vec2(dims);
        uv.y = 1.0 - uv.y; // flip Y-axis

        float phi = uv.x * TWOPI + HPI;
        float theta = uv.y * PI;
        vec3 local_dir = vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi));

        Ray r;
        r.origin = cam_to_world[3].xyz;
        vec3 direction = normalize((cam_to_world * vec4(local_dir, 0.0)).xyz);
        r.t = 1.0/0.0;
        r.inv_direction = 1.0 / direction;

        accumulated_color += trace(r, rng_state);
    }

    vec3 final_color = accumulated_color / float(nb_samples);
    imageStore(output_image, pixel_coords, vec4(final_color, 1.0));
}
