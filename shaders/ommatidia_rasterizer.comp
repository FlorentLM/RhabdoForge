#version 430 core
#include "commons.glsl"

// Number of threads per work group
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: SSBO from binding point 0 contains an array of these structs
layout(std430, binding = 0) readonly buffer OmmatidiaInputBlock {
   Ommatidium ommatidia_data[];
};

// Output: SSBO to write the results to
layout(std430, binding = 1) writeonly buffer OmmatidiaColorOutput {
   vec4 ommatidia_colors[];
};

// Input: scene rendered to a cubemap
layout(binding = 0) uniform samplerCube scene_cubemap;

// Uniforms
uniform int nb_ommatidia;
uniform int nb_samples;
uniform float time; // For temporal dithering


void main()
{
    // Get the unique ID for this specific shader invocation
    uint ommatidium_idx = gl_GlobalInvocationID.x;

    // Stop if out of bounds
    if (ommatidium_idx >= u_num_ommatidia) {
        return;
    }

    // Unpack data for this specific ommatidium
    Ommatidium om = u_ommatidia_data[ommatidium_idx];

    vec3 om_dir = normalize(om.direction.xyz);

    vec3 total_color = vec3(0.0);
    float total_weight = 0.0;

    // Create a local coordinate system for the ommatidium
    vec3 up = abs(om_dir.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(up, om_dir));
    vec3 bitangent = cross(om_dir, tangent);

    // Monte Carlo sampling within a cone
    for (int i = 0; i < u_samples_per_ommatidium; i++) {

        // Generate two random numbers
        float r1 = rand(vec2(ommatidium_idx, i), u_time);
        float r2 = rand(vec2(ommatidium_idx, i) + 0.5, u_time);

        vec3 sample_dir = sampledir(om, tangent, bitangent, om_dir, r1, r2);

        // Each sample has equal weight (distribution is already biased)
        vec3 sampled_color = texture(u_scene_cubemap, sample_dir).rgb;
        total_color += sampled_color;
    }

    // Simple Averaging
    // Normalize by the total number of samples taken
    if (u_samples_per_ommatidium > 0) {
        total_color /= float(u_samples_per_ommatidium);
    }

    // Write the final color to the output SSBO at the correct index
    u_ommatidia_colors[ommatidium_idx] = vec4(total_color, 1.0);
}
