#version 430 core
#include "commons.glsl"

// Number of threads per work group
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: SSBO from binding point 0 contains an array of Receptors structs
layout(std430, binding = 0) readonly buffer ReceptorsInputBlock { ReceptorData receptor_data[]; };

// Output: SSBO to write the results to
layout(std430, binding = 2) writeonly buffer ReceptorsHistory { vec4 history_data[]; };

// Input / Output: Persistent photoreceptor state for temporal accumulation
layout(std430, binding = 3) buffer PhotoreceptorState { vec4 receptor_state[]; };

// Input: scene rendered to a cubemap
layout(binding = 0) uniform samplerCube scene_cubemap;

// Uniforms
uniform int nb_receptors;
uniform int nb_samples;
uniform float dither_counter;
uniform int frame_index;
uniform bool use_quasi_random;
uniform float dt;   // seconds since last frame

void main() {

    // unique ID for this specific shader invocation
    uint rcpt_id = gl_GlobalInvocationID.x;

    // Stop if out of bounds
    if (rcpt_id >= nb_receptors) {
        return;
    }

    ReceptorData rcpt = receptor_data[rcpt_id];
    vec3 rcpt_dir = normalize(rcpt.direction);

    vec3 total_color = vec3(0.0);

    // Local coordinate system for the receptor
    vec3 up = abs(rcpt_dir.y) > 0.99 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = normalize(cross(up, rcpt_dir));
    vec3 bitangent = cross(rcpt_dir, tangent);

    // Pre-compute per-ommatidium offsets for quasi-random mode
    float offset1, offset2;
    if (use_quasi_random) {
        offset1 = rand(vec2(float(rcpt_id), 0.0), 0.0);
        offset2 = rand(vec2(float(rcpt_id), 1.0), 0.0);
    }

    // Monte Carlo sampling within a cone
    for (int i = 0; i < nb_samples; i++) {

        float r1, r2;
        if (use_quasi_random) {
            // Halton sequence
            uint halton_idx = uint(dither_counter) * uint(nb_samples) + uint(i) + 1u;
            float h1 = halton_sequence(halton_idx, 2u);
            float h2 = halton_sequence(halton_idx, 3u);

            r1 = clamp(fract(h1 + offset1), 1e-6, 1.0);  // log(0) in sampledir
            r2 = fract(h2 + offset2);
        } else {
            // Regular randomness
            r1 = rand(vec2(rcpt_id, i), dither_counter);
            r2 = rand(vec2(rcpt_id, i) + 0.5, dither_counter);
        }

         // Each sample has equal weight (distribution is already biased)
        vec3 sample_dir = sampledir(rcpt, tangent, bitangent, rcpt_dir, r1, r2);
        total_color += texture(scene_cubemap, sample_dir).rgb;
    }

    // Simple averaging (norm by number of sampls taken)
    if (nb_samples > 0) {
        total_color /= float(nb_samples);
    }

    vec3 output_color;
    float tau = rcpt.tau;

    if (tau > 0.0) {
        // Exponential moving average (first-order low-pass)
        float alpha = dt / (tau + dt);
        vec3 prev = receptor_state[rcpt_id].rgb;
        output_color = mix(prev, total_color, alpha);
        receptor_state[rcpt_id] = vec4(output_color, 1.0);
    } else {
        output_color = total_color;
    }

    uint output_index = (frame_index * nb_receptors) + rcpt_id;
    history_data[output_index] = vec4(output_color, 1.0);
}
