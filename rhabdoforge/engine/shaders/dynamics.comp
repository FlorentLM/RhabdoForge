#version 430 core
#include "commons.glsl"

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = BINDING_RHAB_STATIC)  readonly buffer RhabStaticBlock        { RhabdomereStatic  rhab_static[]; };
layout(std430, binding = BINDING_OMM_STATIC)   readonly buffer OmmatidiumStaticBlock  { OmmatidiumStatic      omm_static[]; };
layout(std430, binding = BINDING_EMA_STATE)    readonly buffer EmaHistory             { vec4 ema_state[]; };
layout(std430, binding = BINDING_RHAB_DYNAMIC) buffer          RhabDynamicBlock       { RhabdomereDynamic rhab_dynamic[]; };
layout(std430, binding = BINDING_OMM_DYNAMIC)  buffer          OmmatidiumDynamicBlock { OmmatidiumDynamic     omm_dynamic[]; };

uniform int   nb_ommatidia;
uniform int   rhab_per_omm;
uniform float dt;                 // simulation timestep (s)
uniform bool  enable_actuation;   // toggle for photomechanical saccades
uniform float lum_ref;            // operating-point luminance for biochemical gain
uniform float retina_drive_um[8]; // retina muscle pull strength (one per eye ID (0-7))
uniform float noise_threshold;
uniform float clip_ratio;          // Non-optical RF clipping at full lateral saccade (1.0 = pure optics)
uniform bool  force_pupil_drive;   // Override steady_state_drive with pupil_drive
uniform float pupil_drive;
uniform bool  force_saccade_drive;  // Override the reflex arc with saccade_drive
uniform float saccade_drive;
uniform float trigger_delay;       // onset latency between light detection and movement start (s)

void main() {
    uint omm_idx = gl_GlobalInvocationID.x;
    if (omm_idx >= nb_ommatidia) return;      // stop if out of bounds

    uint start_idx = omm_idx * rhab_per_omm;
    OmmatidiumDynamic od = omm_dynamic[omm_idx];
    OmmatidiumStatic  os = omm_static[omm_idx];

    // Signal detection EMAs
    // lum contains the concentrated radiance (from reduction.comp)
    // -> adaptation responds to the light the waveguide actually receives
    float lum = 0.0;
    for (int r = 0; r < rhab_per_omm; r++) {
        lum += ema_state[start_idx + r].w;
    }
    lum /= float(rhab_per_omm);

    float alpha_fast  = exp(-dt / max(os.tau_fast, 0.001));
    float alpha_adapt = exp(-dt / max(os.tau_adapt, 0.001));

    if (od.curr_lum_slow < 1e-6) {
        od.curr_lum_slow = max(lum, 0.001); // avoid div by 0 later
        od.curr_lum_fast    = lum;
    } else {
        od.curr_lum_fast    = mix(lum, od.curr_lum_fast,    alpha_fast);
        od.curr_lum_slow = mix(lum, od.curr_lum_slow, alpha_adapt);
    }

    // Raw contrast
    float contrast = (od.curr_lum_fast - od.curr_lum_slow) / (od.curr_lum_slow + 0.05);
//    float contrast = (ld.curr_lum_fast - ld.curr_lum_slow) / ld.curr_lum_slow;         // DEBUG

    // Deadzone: subtract noise threshold
    float clean_contrast = max(0.0, contrast - (noise_threshold * 1.0));
//    float clean_contrast = contrast;                                          // DEBUG

    // Steady-state light level (phototropic state), independent of the reflex below
    float steady_state_drive = force_pupil_drive ? pupil_drive
        : (od.curr_lum_slow / (od.curr_lum_slow + lum_ref));

    // Photomechanical microsaccade
    //   A crossing of clean_contrast launches the sequence:
    //   idle -> latency (fixed onset delay, committed) -> moving (fixed-duration ballistic
    //   move to full amplitude, also committed) -> returning (interruptible by a new trigger)
    bool  triggered  = enable_actuation && (clean_contrast > 0.0);
    float mech_phase = od.mech_phase;
    float mech_t      = od.mech_t + dt;
    float mech_frac0 = od.mech_frac0;
    float mech_frac;

    if (mech_phase < 0.5) {                                // idle
        mech_frac = 0.0;
        if (triggered) { mech_phase = 1.0; mech_t = 0.0; mech_frac0 = 0.0; }

    } else if (mech_phase < 1.5) {                          // latency: committed, frozen
        mech_frac = mech_frac0;
        if (mech_t >= trigger_delay) { mech_phase = 2.0; mech_t = 0.0; }

    } else if (mech_phase < 2.5) {                          // moving: committed ballistic ramp to 1.0
        mech_frac = mix(mech_frac0, 1.0, clamp(mech_t / max(os.move_duration, 1e-6), 0.0, 1.0));
        if (mech_t >= os.move_duration) { mech_phase = 3.0; mech_t = 0.0; mech_frac0 = 1.0; }

    } else {                                                // returning: interruptible ramp to 0.0
        mech_frac = mix(mech_frac0, 0.0, clamp(mech_t / max(os.return_duration, 1e-6), 0.0, 1.0));
        if (triggered) {
            mech_phase = 1.0; mech_t = 0.0; mech_frac0 = mech_frac;   // re-trigger from here
        } else if (mech_t >= os.return_duration) {
            mech_phase = 0.0; mech_t = 0.0; mech_frac0 = 0.0; mech_frac = 0.0;
        }
    }

    // Override: hold a fixed excursion
    if (force_saccade_drive) {
        mech_phase = 0.0;
        mech_t     = 0.0;
        mech_frac0 = 0.0;
        mech_frac  = clamp(saccade_drive, 0.0, 1.0);
    }

    od.mech_phase = mech_phase;
    od.mech_t = mech_t;
    od.mech_frac0 = mech_frac0;

    od.curr_lateral_disp = mech_frac * os.ampl_lateral;
    od.curr_axial_disp   = mech_frac * os.ampl_axial;

    omm_dynamic[omm_idx] = od;

    // Biochemical adaptation (Naka-Rushton)
    // -> neural gain based on the adapted light level
    float lum_gain = lum_ref / (lum_ref + max(od.curr_lum_slow, 0.0));

    // Optics and movement geometry
    float d_rest = os.focal_um;            // per-ommatidium focal length (lever arm)
    float d_eff  = max(d_rest + od.curr_axial_disp, 1.0);

    uint eye_id = unpack_eye_id(rhab_static[start_idx].metadata);
    float muscle_tug = retina_drive_um[eye_id];

    // RF width has three independent sources:
    //   - Axial: the move slides the tip along the optical axis, changing its defocus.
    //      Saturates at the baked axial_scale_floor.
    //   - Pupil: the screening pigment absorbs the boundary wave of the higher-order modes.
    //      Driven by the steady light level, per rhabdomere.
    //   - Clipping (clip_ratio): RF vignetting against the lens's Airy footprint and/or
    //      the cone/pigment-cell aperture. Both driven by the lateral move, both geometric
    //      blocking rather than a modal or absorptive effect like the two above.
    float lat_frac = clamp(od.curr_lateral_disp / max(os.ampl_lateral, 1e-6), 0.0, 1.0);
    float axial_frac = clamp(od.curr_axial_disp / max(os.ampl_axial, 1e-6), 0.0, 1.0);
    float er = (clip_ratio <= 0.0) ? 1.0 : clip_ratio;  // unset uniform -> pure optics

    for (int r = 0; r < rhab_per_omm; r++) {

        uint rhab_idx = start_idx + r;
        RhabdomereStatic rs = rhab_static[rhab_idx];

        // Compose lateral movements (microsaccade + retinal movement)
        vec2 sacc_off = od.curr_lateral_disp * os.saccade_dxdy;
        vec2 musc_off = muscle_tug * os.retina_dxdy;
        vec2 total_xy = rs.rest_offset + sacc_off + musc_off;

        vec3 tip = (total_xy.x * os.right) + (total_xy.y * os.up) + (-d_eff * os.forward);
        rhab_dynamic[rhab_idx].curr_direction = normalize(-tip);

        float optical_scale = mix(1.0, rs.axial_scale_floor, axial_frac);
        float pupil_scale   = mix(1.0, rs.closed_pupil_ratio, steady_state_drive);
        float clip_scale    = mix(1.0, er, lat_frac * rs.lateral_clip_enabled);

        rhab_dynamic[rhab_idx].curr_acc_angles = rs.rest_acc_angles * (optical_scale * pupil_scale * clip_scale);

        // Photon concentration reads the optical narrowing only: the pupil narrows by absorbing
        // light (opposite sign), and clipping is not optical at all
        rhab_dynamic[rhab_idx].optical_scale = optical_scale;
        rhab_dynamic[rhab_idx].pupil_transmit = mix(1.0, rs.closed_pupil_transmit, steady_state_drive);

        // This is purely the biochemical/neural gain (the optical concentration is done in reduction.comp)
        rhab_dynamic[rhab_idx].curr_adaptation = lum_gain;
    }
}