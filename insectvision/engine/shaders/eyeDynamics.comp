#version 430 core
#include "commons.glsl"

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = BINDING_RCPT_STATIC)  readonly buffer RcptStaticBlock  { ReceptorStatic  rcpt_static[]; };
layout(std430, binding = BINDING_LENS_STATIC)  readonly buffer LensStaticBlock  { LensStatic      lens_static[]; };
layout(std430, binding = BINDING_EMA_STATE)    readonly buffer EmaHistory       { vec4 ema_state[]; };
layout(std430, binding = BINDING_RCPT_DYNAMIC) buffer          RcptDynamicBlock { ReceptorDynamic rcpt_dynamic[]; };
layout(std430, binding = BINDING_LENS_DYNAMIC) buffer          LensDynamicBlock { LensDynamic     lens_dynamic[]; };

uniform int   nb_lenses;
uniform int   receptors_per_lens;
uniform float dt;                 // simulation timestep (s)
uniform bool  enable_actuation;   // toggle for photomechanical saccades
uniform float lum_ref;            // operating-point luminance for biochemical gain
uniform float retina_drive_um[8]; // retina muscle pull strength (one per eye ID (0-7))
uniform float noise_threshold;
uniform float extra_narrow_ratio; // Extra, non-optical RF narrowing at full saccade (i.e. ~ voltage-level hyperacuity)
                                  // 1.0 = pure optics

void main() {
    uint lens_idx = gl_GlobalInvocationID.x;
    if (lens_idx >= nb_lenses) return;      // stop if out of bounds

    uint start_idx = lens_idx * receptors_per_lens;
    LensDynamic ld = lens_dynamic[lens_idx];
    LensStatic  ls = lens_static[lens_idx];

    // Signal detection EMAs
    // lum contains the concentrated radiance (from reduction.comp)
    // -> adaptation responds to the light the waveguide actually receives
    float lum = 0.0;
    for (int r = 0; r < receptors_per_lens; r++) {
        lum += ema_state[start_idx + r].w;
    }
    lum /= float(receptors_per_lens);

    float alpha_fast  = exp(-dt / max(ls.tau_fast, 0.001));
    float alpha_adapt = exp(-dt / max(ls.tau_adapt, 0.001));

    if (ld.adapted_lum < 1e-6) {
        ld.adapted_lum = max(lum, 0.001); // avoid div by 0 later
        ld.fast_lum    = lum;
    } else {
        ld.fast_lum    = mix(lum, ld.fast_lum,    alpha_fast);
        ld.adapted_lum = mix(lum, ld.adapted_lum, alpha_adapt);
    }

    // Raw contrast
    float contrast = (ld.fast_lum - ld.adapted_lum) / (ld.adapted_lum + 0.05);
//    float contrast = (ld.fast_lum - ld.adapted_lum) / ld.adapted_lum;         // DEBUG

    // Deadzone: subtract noise threshold
    float clean_contrast = max(0.0, contrast - (noise_threshold * 1.0));
//    float clean_contrast = contrast;                                          // DEBUG

//    // Apply gain curve
    float sensitivity = 0.2;
//    float bright_drive = max(0.0, tanh(clean_contrast / sensitivity));

    // A mix of temporal change (saccade) and steady-state light level (phototropic state)
    float steady_state_drive = ld.adapted_lum / (ld.adapted_lum + lum_ref);
    float transient_drive    = max(0.0, tanh(clean_contrast / sensitivity));

    // Total drive is a combination
    float bright_drive = clamp(steady_state_drive * 0.2 + transient_drive * 0.8, 0.0, 1.0);

    float target_lat = enable_actuation ? (bright_drive * ls.ampl_lat_um) : 0.0;
    float target_ax  = enable_actuation ? (bright_drive * ls.ampl_ax_um)  : 0.0;

    // Safety mechanical floor: mix between biological speed and render-noise stability
    float safety_floor = mix(0.001, 0.010, clamp(noise_threshold * 5.0, 0.0, 1.0));
    float rate_lat = (target_lat > ld.lateral_um) ? max(ls.tau_rise, safety_floor) : max(ls.tau_relax, safety_floor);
    float rate_ax  = (target_ax  > ld.axial_um)   ? max(ls.tau_rise, safety_floor) : max(ls.tau_relax, safety_floor);

    ld.lateral_um = mix(target_lat, ld.lateral_um, exp(-dt / rate_lat));
    ld.axial_um   = mix(target_ax,  ld.axial_um,   exp(-dt / rate_ax));

    lens_dynamic[lens_idx] = ld;

    // Biochemical adaptation (Naka-Rushton)
    // -> neural gain based on the adapted light level
    float lum_gain = lum_ref / (lum_ref + max(ld.adapted_lum, 0.0));

    // Optics and movement geometry
    float d_rest = ls.focal_um;            // per-lens focal length (lever arm)
    float d_eff  = max(d_rest + ld.axial_um, 1.0);

    uint eye_id = unpack_eye_id(rcpt_static[start_idx].metadata);
    float muscle_tug = retina_drive_um[eye_id];

    // RF narrowing has two independent sources:
    //   - Optical (derived, per receptor below): the axial move recedes the tip to d_eff,
    //      shrinking the geometric blur arctan(d_rhab/d_eff). Computed from the same Snyder
    //      terms that baked rest_acc. It scales with the axial amplitude (ampl_ax_um -> axial_um -> d_eff).
    //   - Phenomenological (extra_narrow_ratio): extra non-optical narrowing.
    //      Ramps with the saccade, independent of the optics.
    float disp_frac   = clamp(ld.axial_um / max(ls.ampl_ax_um, 1e-6), 0.0, 1.0);
    float pheno_scale = mix(1.0, extra_narrow_ratio, disp_frac);

    for (int r = 0; r < receptors_per_lens; r++) {
        uint rcpt_idx = start_idx + r;
        ReceptorStatic rs = rcpt_static[rcpt_idx];

        // Compose lateral movements (microsaccade + retinal movement)
        vec2 sacc_off = ld.lateral_um * vec2(ls.sacc_local_x, ls.sacc_local_y);
        vec2 musc_off = muscle_tug * vec2(ls.retina_x, ls.retina_y);
        vec2 total_xy = rs.rot_offset + sacc_off + musc_off;

        vec3 tip = (total_xy.x * ls.right) + (total_xy.y * ls.up) + (-d_eff * ls.forward);
        rcpt_dynamic[rcpt_idx].direction = normalize(-tip);

        // Optical narrowing from the axial move (diffraction term is unchanged by the
        // saccade, only the geometric blur recedes with d_eff)
        float rho_diff  = rs.wavelength_um / max(ls.lens_diameter_um, 1e-3);
        float geom_rest = atan(rs.rhab_diameter_um / max(d_rest, 1e-3));
        float geom_eff  = atan(rs.rhab_diameter_um / max(d_eff,  1e-3));
        float opt_rest  = sqrt(geom_rest*geom_rest + rho_diff*rho_diff);
        float opt_eff   = sqrt(geom_eff*geom_eff   + rho_diff*rho_diff);
        float optical_scale = opt_eff / max(opt_rest, 1e-9);   // Droso: ~ x0.92 at a 2 um move with 21 um lever arm

        rcpt_dynamic[rcpt_idx].acc_axes      = rs.rest_acc * (optical_scale * pheno_scale);
        rcpt_dynamic[rcpt_idx].optical_scale = optical_scale;  // for photon concentration

        // This is purely the biochemical/neural gain (the optical concentration is done in reduction.comp)
        rcpt_dynamic[rcpt_idx].adaptation_state = lum_gain;
    }
}