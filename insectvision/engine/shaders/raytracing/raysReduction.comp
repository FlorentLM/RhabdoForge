#version 430 core

#include "commons.glsl"

// One thread per receptor
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: Receptor data (mostly just for tau)
layout(std430, binding = 0) readonly buffer ReceptorsDataBlock { ReceptorData receptor_data[]; };
// Input: Intermediate results
layout(std430, binding = 4) readonly buffer RayResults { vec4 ray_results[]; };
// Input/Output: Current state for time accumulation
layout(std430, binding = 3) buffer PhotoreceptorState { vec4 receptor_state[]; };
// Output: Colors
layout(std430, binding = 2) writeonly buffer ReceptorsHistory { vec4 history_data[]; };


// Uniforms
uniform int nb_samples;
uniform int nb_receptors;
uniform int frame_offset;
uniform float dt;   // seconds since last frame

void main() {
    uint receptor_idx = gl_GlobalInvocationID.x;

    // Stop if out of bounds
    if (receptor_idx >= nb_receptors) {
        return;
    }

    vec3 total_color = vec3(0.0);
    uint start_idx = receptor_idx * nb_samples;

    for (int i = 0; i < nb_samples; ++i) {
        total_color += ray_results[start_idx + i].rgb;
    }

    if (nb_samples > 0) {
        total_color /= float(nb_samples);
    }

    float sensitivity = receptor_data[receptor_idx].sensitivity;
    total_color *= sensitivity;

    vec3 output_color;
    float tau = receptor_data[receptor_idx].tau;

    if (tau > 0.0) {
        // Exponential moving average (first-order low-pass)
        float alpha = dt / (tau + dt);
        vec3 prev = receptor_state[receptor_idx].rgb;
        output_color = mix(prev, total_color, alpha);
        receptor_state[receptor_idx] = vec4(output_color, 1.0);
    } else {
        output_color = total_color;
    }

    uint output_index = (frame_offset * nb_receptors) + receptor_idx;
    history_data[output_index] = vec4(output_color, 1.0);
}