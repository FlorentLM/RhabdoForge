#version 430 core
#include "commons.glsl"

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = BINDING_RHAB_STATIC)  readonly buffer RhabStaticBlock        { RhabdomereStatic  rhab_static[]; };
layout(std430, binding = BINDING_OMM_STATIC)   readonly buffer OmmatidiumStaticBlock  { OmmatidiumStatic      omm_static[]; };
layout(std430, binding = BINDING_EMA_STATE)    readonly buffer EmaHistory             { vec4 ema_state[]; };
layout(std430, binding = BINDING_RHAB_DYNAMIC) buffer          RhabDynamicBlock       { RhabdomereDynamic rhab_dynamic[]; };
layout(std430, binding = BINDING_OMM_DYNAMIC)  buffer          OmmatidiumDynamicBlock { OmmatidiumDynamic     omm_dynamic[]; };

uniform int   nb_ommatidia;
uniform int   rhab_per_omm;
uniform float dt;                 // simulation timestep (s)
uniform bool  enable_actuation;   // toggle for photomechanical saccades
uniform float lum_ref;            // operating-point luminance for biochemical gain
uniform float retina_drive_um[8]; // retina muscle pull strength (one per eye ID (0-7))
uniform float noise_threshold;
uniform float extra_narrowing_ratio; // Extra, non-optical RF narrowing at full saccade (i.e. ~ voltage-level hyperacuity)
                                    // 1.0 = pure optics

void main() {
    uint omm_idx = gl_GlobalInvocationID.x;
    if (omm_idx >= nb_ommatidia) return;      // stop if out of bounds

    uint start_idx = omm_idx * rhab_per_omm;
    OmmatidiumDynamic od = omm_dynamic[omm_idx];
    OmmatidiumStatic  os = omm_static[omm_idx];

    // Signal detection EMAs
    // lum contains the concentrated radiance (from reduction.comp)
    // -> adaptation responds to the light the waveguide actually receives
    float lum = 0.0;
    for (int r = 0; r < rhab_per_omm; r++) {
        lum += ema_state[start_idx + r].w;
    }
    lum /= float(rhab_per_omm);

    float alpha_fast  = exp(-dt / max(os.tau_fast, 0.001));
    float alpha_adapt = exp(-dt / max(os.tau_adapt, 0.001));

    if (od.curr_lum_slow < 1e-6) {
        od.curr_lum_slow = max(lum, 0.001); // avoid div by 0 later
        od.curr_lum_fast    = lum;
    } else {
        od.curr_lum_fast    = mix(lum, od.curr_lum_fast,    alpha_fast);
        od.curr_lum_slow = mix(lum, od.curr_lum_slow, alpha_adapt);
    }

    // Raw contrast
    float contrast = (od.curr_lum_fast - od.curr_lum_slow) / (od.curr_lum_slow + 0.05);
//    float contrast = (ld.curr_lum_fast - ld.curr_lum_slow) / ld.curr_lum_slow;         // DEBUG

    // Deadzone: subtract noise threshold
    float clean_contrast = max(0.0, contrast - (noise_threshold * 1.0));
//    float clean_contrast = contrast;                                          // DEBUG

//    // Apply gain curve
    float sensitivity = 0.2;

    // A mix of temporal change (saccade) and steady-state light level (phototropic state)
    float steady_state_drive = od.curr_lum_slow / (od.curr_lum_slow + lum_ref);
    float transient_drive    = max(0.0, tanh(clean_contrast / sensitivity));

    // Total drive is a combination
    float bright_drive = clamp(steady_state_drive * 0.2 + transient_drive * 0.8, 0.0, 1.0);

    float target_lat = enable_actuation ? (bright_drive * os.ampl_lateral) : 0.0;
    float target_ax  = enable_actuation ? (bright_drive * os.ampl_axial)  : 0.0;

    // Safety mechanical floor: mix between biological speed and render-noise stability
    float safety_floor = mix(0.001, 0.010, clamp(noise_threshold * 5.0, 0.0, 1.0));
    float rate_lat = (target_lat > od.curr_lateral_disp) ? max(os.tau_rise, safety_floor) : max(os.tau_relax, safety_floor);
    float rate_ax  = (target_ax  > od.curr_axial_disp)   ? max(os.tau_rise, safety_floor) : max(os.tau_relax, safety_floor);

    od.curr_lateral_disp = mix(target_lat, od.curr_lateral_disp, exp(-dt / rate_lat));
    od.curr_axial_disp   = mix(target_ax,  od.curr_axial_disp,   exp(-dt / rate_ax));

    omm_dynamic[omm_idx] = od;

    // Biochemical adaptation (Naka-Rushton)
    // -> neural gain based on the adapted light level
    float lum_gain = lum_ref / (lum_ref + max(od.curr_lum_slow, 0.0));

    // Optics and movement geometry
    float d_rest = os.focal_um;            // per-ommatidium focal length (lever arm)
    float d_eff  = max(d_rest + od.curr_axial_disp, 1.0);

    uint eye_id = unpack_eye_id(rhab_static[start_idx].metadata);
    float muscle_tug = retina_drive_um[eye_id];

    // RF narrowing has two independent sources:
    //   - Optical (derived, per rhabdomere below): the axial move recedes the tip to d_eff,
    //      shrinking the geometric blur arctan(d_rhab/d_eff). Computed from the same Snyder
    //      terms that baked rest_acc_angles. It scales with the axial amplitude (ampl_axial -> curr_axial_disp -> d_eff).
    //   - Phenomenological (extra_narrowing_ratio): extra non-optical narrowing.
    //      Ramps with the saccade, independent of the optics.
    float disp_frac   = clamp(od.curr_axial_disp / max(os.ampl_axial, 1e-6), 0.0, 1.0);
    float er = (extra_narrowing_ratio <= 0.0) ? 1.0 : extra_narrowing_ratio;  // unset uniform -> pure optics
    float pheno_scale = mix(1.0, er, disp_frac);

    for (int r = 0; r < rhab_per_omm; r++) {

        uint rhab_idx = start_idx + r;
        RhabdomereStatic rs = rhab_static[rhab_idx];

        // Compose lateral movements (microsaccade + retinal movement)
        vec2 sacc_off = od.curr_lateral_disp * os.saccade_dxdy;
        vec2 musc_off = muscle_tug * os.retina_dxdy;
        vec2 total_xy = rs.rest_offset + sacc_off + musc_off;

        vec3 tip = (total_xy.x * os.right) + (total_xy.y * os.up) + (-d_eff * os.forward);
        rhab_dynamic[rhab_idx].curr_direction = normalize(-tip);

        // Optical narrowing from the axial move (diffraction term is unchanged by the
        // saccade, only the geometric blur recedes with d_eff)
        float rho_diff  = rs.wavelength_um / max(os.aperture_um, 1e-3);
        float geom_rest = atan(rs.diameter_um / max(d_rest, 1e-3));
        float geom_eff  = atan(rs.diameter_um / max(d_eff,  1e-3));
        float opt_rest  = sqrt(geom_rest*geom_rest + rho_diff*rho_diff);
        float opt_eff   = sqrt(geom_eff*geom_eff   + rho_diff*rho_diff);
        float optical_scale = opt_eff / max(opt_rest, 1e-9);   // Droso: ~ x0.92 at a 2 um move with 21 um lever arm

        rhab_dynamic[rhab_idx].curr_acc_angles      = rs.rest_acc_angles * (optical_scale * pheno_scale);
        rhab_dynamic[rhab_idx].optical_scale = optical_scale;  // for photon concentration

        // This is purely the biochemical/neural gain (the optical concentration is done in reduction.comp)
        rhab_dynamic[rhab_idx].curr_adaptation = lum_gain;
    }
}