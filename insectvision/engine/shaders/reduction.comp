#version 430 core
#include "commons.glsl"

// One thread per receptor
layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer  RcptStaticBlock  { ReceptorStatic rcpt_static[]; };
layout(std430, binding = 2) writeonly buffer ColorOutput      { vec4 history_data[]; };
layout(std430, binding = 3) buffer           EmaHistory       { vec4 ema_state[]; };
layout(std430, binding = 4) readonly buffer  RcptDynamicBlock { ReceptorDynamic rcpt_dynamic[]; };
layout(std430, binding = 5) readonly buffer  RayResults       { vec4 ray_results[]; };

// Uniforms
uniform int nb_samples;
uniform int nb_receptors;
uniform int frame_offset;
uniform float dt;   // seconds since last frame

void main() {
    uint rcpt_idx = gl_GlobalInvocationID.x;

    // Stop if out of bounds
    if (rcpt_idx >= nb_receptors) {
        return;
    }

    vec3 total_color = vec3(0.0);
    uint start_idx = rcpt_idx * nb_samples;

    for (int i = 0; i < nb_samples; ++i) {
        total_color += ray_results[start_idx + i].rgb;
    }

    vec3 spec_sens = rcpt_static[rcpt_idx].sensitivity;
    float tau      = rcpt_static[rcpt_idx].tau;

    total_color = (nb_samples > 0) ? (total_color / float(nb_samples)) : total_color;
    total_color *= spec_sens;

    // radiance before adaptation
    float raw_radiance = (total_color.r + total_color.g + total_color.b) / 3.0;

     vec4 ema_val;
    if (tau > 0.0 && dt > 0.0) {
        // Exponential moving average (first-order low-pass)
        float alpha = clamp(dt / (tau + dt), 0.0, 1.0);
        vec4 prev = ema_state[rcpt_idx];

        // If prev is 0 (first frame) pop it instantly
        if (length(prev) < 1e-6) {
            ema_val = vec4(total_color, raw_radiance);
        } else {
            vec3 filtered_rgb = mix(prev.rgb, total_color, alpha);
            float filtered_rad = mix(prev.w, raw_radiance, alpha);
            ema_val = vec4(filtered_rgb, filtered_rad);
        }
        ema_state[rcpt_idx] = ema_val;
    } else {
        ema_val = vec4(total_color, raw_radiance);
    }

    float adapt = rcpt_dynamic[rcpt_idx].adaptation_state;
    vec4 out_val = vec4(ema_val.rgb * adapt, ema_val.w * adapt);

    // frame offset logic for batched rendering
    uint out_idx = (frame_offset * nb_receptors) + rcpt_idx;
    history_data[out_idx] = out_val;
}