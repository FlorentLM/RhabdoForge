#version 430 core
#include "commons.glsl"

layout (local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer RcptStaticBlock  { ReceptorStatic  rcpt_static[]; };
layout(std430, binding = 4) readonly buffer RcptDynamicBlock { ReceptorDynamic rcpt_dynamic[]; };
layout(std430, binding = 5) writeonly buffer RayResultBuffer { vec4 ray_results[]; };

layout(binding = 0) uniform samplerCube scene_cubemap;

uniform int nb_receptors;
uniform int nb_samples;
uniform float dither_counter;
uniform bool use_quasi_random;

void main() {
    uint global_id = gl_GlobalInvocationID.x;
    uint total_count = rcpt_static.length();

    if (global_id >= (nb_samples * total_count)) {
        return;
    }

    uint r_idx = global_id / nb_samples;
    uint s_idx = global_id % nb_samples;

    ReceptorStatic rs = rcpt_static[r_idx];
    ReceptorDynamic rd = rcpt_dynamic[r_idx];

    // Reconstruct tangent frame from actuated direction
    vec3 F = rd.direction;
    vec3 up = abs(F.y) > 0.99 ? vec3(1,0,0) : vec3(0,1,0);
    vec3 T = normalize(cross(up, F));
    vec3 B = cross(F, T);

    uint rng = pcg_hash(r_idx * 1973u + uint(dither_counter) * 26699u + s_idx * 749u);
    float r1, r2;

    if (use_quasi_random) {
        uint h_idx = uint(dither_counter) * uint(nb_samples) + s_idx + 1u;
        uint hash = pcg_hash(r_idx * 1973u);
        r1 = clamp(fract(halton_sequence(h_idx, 2u) + float(hash & 0xFFFFu)/65535.0), 1e-6, 1.0);
        r2 = fract(halton_sequence(h_idx, 3u) + float((hash >> 16u) & 0xFFFFu)/65535.0);
    } else {
        r1 = float(pcg_hash(rng)) / 4294967295.0;
        r2 = float(pcg_hash(rng + 1u)) / 4294967295.0;
    }

    vec3 sample_dir = sampledir(rs, rd, T, B, F, max(r1, 1e-6), r2);
    vec3 color = texture(scene_cubemap, sample_dir).rgb;

    ray_results[global_id] = vec4(color, 1.0);
}